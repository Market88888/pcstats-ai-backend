# Необязательно
DEFAULT_DAILY_LIMIT=50                # сообщений в сутки на одного игрока
TZ_OFFSET_HOURS=3                     # во сколько часов по UTC сбрасывается "сутки" (3 = Киев/Москва)
PORT=3000

# Хранилище (чтобы ключи и счётчики не пропадали на Render Free):
# создай бесплатную базу на upstash.com и вставь сюда
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# или смонтируй Render Disk и укажи папку:
DATA_DIR=./data
